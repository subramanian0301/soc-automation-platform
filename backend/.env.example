# SOC Security Platform Backend Configuration Template
PORT=4000
NODE_ENV=development

# JWT Secret: In production, MUST be at least 32 characters and securely generated.
# Fallbacks to default keys are strictly prohibited and will abort startup in production.
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters_in_all_environments
JWT_EXPIRES_IN=15m

# Demo Mode Flags: Set to false or omit in production environments
ALLOW_DEMO_TOKEN=true
ALLOW_DEMO_LOGIN=true

# Database & Storage
DATABASE_URL=mysql://root:root@127.0.0.1:3306/soc_platform
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=../uploads
