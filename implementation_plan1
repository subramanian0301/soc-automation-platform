## 3. Prisma Schema Design

```prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ThreatLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SoarStatus {
  COMPLETED
  PENDING_APPROVAL
  RECOMMENDED
  FAILED
}

model Analysis {
  id               String         @id @default(uuid())
  analysisId       String         @unique @default(cuid())
  fileName         String
  originalFileName String
  fileSize         Int
  fileType         String
  mimeType         String
  uploadedAt       DateTime       @default(now())
  analysisTime     DateTime?
  hostname         String?
  username         String?
  operatingSystem  String?
  riskScore        Int?
  threatLevel      ThreatLevel?   // Nullable: missing threat level stored as NULL -> rendered "Not Available"
  recommendation   String?        @db.Text
  status           AnalysisStatus @default(PENDING)
  source           String?        @db.Text
  isArchived       Boolean        @default(false) // Deactivate/Archive instead of permanent delete
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relationships
  fileMetadata      FileMetadata?
  hashes            Hash?
  fileProperties    FileProperty?
  yaraResults       YaraResult[]
  virusTotalResult  VirusTotalResult?
  iocs              Ioc[]
  mitreTechniques   MitreTechnique[]
  behaviorEvents    BehaviorEvent[]
  sandboxResults    SandboxResult[]
  siemEvents        SiemEvent[]
  incidents         Incident[]
  cases             Case[]
  soarExecutions    SoarExecution[]
  assets            Asset[]
  endpoints         Endpoint[]
  vulnerabilities   Vulnerability[]
  auditLogs         AuditLog[]

  @@index([analysisId])
  @@index([createdAt])
  @@index([threatLevel])
  @@index([isArchived])
}

model FileMetadata {
  id          String   @id @default(uuid())
  analysisId  String   @unique
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  filePath    String   // Preserved path in /uploads
  storageKey  String
  extension   String
  headerMagic String?
  encoding    String?

  @@index([analysisId])
}

model Hash {
  id         String   @id @default(uuid())
  analysisId String   @unique
  analysis   Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  md5        String?
  sha1       String?
  sha256     String?
  ssdeep     String?

  @@index([analysisId])
}

model FileProperty {
  id               String   @id @default(uuid())
  analysisId       String   @unique
  analysis         Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  entropy          Float?
  digitalSignature String?
  isPacked         Boolean?
  packer           String?
  imports          Json?
  suspiciousApis   Json?

  @@index([analysisId])
}

model YaraResult {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  ruleName    String
  namespace   String?
  tags        Json?
  meta        Json?
  description String?

  @@index([analysisId])
}

model VirusTotalResult {
  id           String   @id @default(uuid())
  analysisId   String   @unique
  analysis     Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  positives    Int
  total        Int
  permalink    String?
  scanDate     String?
  detections   Json?

  @@index([analysisId])
}

model Ioc {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  type        String   // IP, DOMAIN, URL, EMAIL, HASH
  value       String
  category    String?
  confidence  Int?
  description String?

  @@index([analysisId])
  @@index([type, value])
}

model MitreTechnique {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  tactic      String
  techniqueId String
  name        String
  description String?  @db.Text

  @@index([analysisId])
}

model BehaviorEvent {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  eventType   String
  action      String
  target      String
  details     String?  @db.Text
  timestamp   DateTime?

  @@index([analysisId])
}

model SandboxResult {
  id           String   @id @default(uuid())
  analysisId   String
  analysis     Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  sandboxName  String
  verdict      String
  score        Int?
  details      Json?

  @@index([analysisId])
}

model SiemEvent {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  eventId     String?
  sourceIp    String?
  destIp      String?
  sourcePort  Int?
  destPort    Int?
  protocol    String?
  action      String?
  severity    String?
  rawEvent    String   @db.Text
  timestamp   DateTime

  @@index([analysisId])
}

model Incident {
  id           String       @id @default(uuid())
  analysisId   String
  analysis     Analysis     @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  title        String
  severity     ThreatLevel?
  status       String
  reason       String       // Logged reason: explicit source entry vs rule engine output
  assignedTo   String?
  createdAt    DateTime     @default(now())

  @@index([analysisId])
}

model Case {
  id           String   @id @default(uuid())
  analysisId   String
  analysis     Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  caseNumber   String   @unique
  title        String
  status       String
  priority     String
  summary      String?  @db.Text

  @@index([analysisId])
}

model SoarExecution {
  id          String     @id @default(uuid())
  analysisId  String
  analysis    Analysis   @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  actionName  String
  target      String?
  status      SoarStatus
  executionLog String?   @db.Text
  timestamp   DateTime   @default(now())

  @@index([analysisId])
}

model Asset {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  assetName   String
  ipAddress   String?
  macAddress  String?
  assetType   String?
  criticality String?

  @@index([analysisId])
}

model Endpoint {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  hostname    String
  osVersion   String?
  agentStatus String?
  lastSeen    DateTime?

  @@index([analysisId])
}

model Vulnerability {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)
  cveId       String
  title       String
  cvssScore   Float?
  severity    String?
  description String?  @db.Text

  @@index([analysisId])
}

model AuditLog {
  id          String    @id @default(uuid())
  analysisId  String?
  analysis    Analysis? @relation(fields: [analysisId], references: [analysisId], onDelete: SetNull)
  action      String
  performedBy String
  timestamp   DateTime  @default(now())
  details     String?   @db.Text
}
```

